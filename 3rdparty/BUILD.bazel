load("@rules_rust//crate_universe:defs.bzl", "crate", "crates_vendor")

crates_vendor(
    name = "crates_vendor",
    annotations = {
        "rb-sys": [crate.annotation(
            gen_build_script = True,
        )],
        "pyo3-build-config": [crate.annotation(
            build_script_env = {
                "PYO3_NO_PYTHON": "1",
            },
        )],
    },
    cargo_lockfile = "Cargo.lock",
    generate_binaries = True,
    generate_build_scripts = True,
    mode = "remote",
    packages = {
        "clap": crate.spec(
            version = "4.6.7",
        ),
        "proc-macro-error": crate.spec(
            version = "1.0.4",
        ),
        "log": crate.spec(
            version = "0.4.34",
            features = ["std"],
        ),
        "cxx": crate.spec(
            version = "=1.0.205",
        ),
        # pest's default `std` feature pulls in stacker/psm, whose build script
        # needs a C archiver that rules_rust cannot provide for wasm32. The
        # proc-macro crates (pest_meta) still enable `std` for host builds.
        "pest": crate.spec(
            version = "2.9.3",
            default_features = False,
            features = ["memchr"],
        ),
        "pest_derive": crate.spec(
            version = "2.9.3",
        ),
        "unicode-normalization": crate.spec(
            version = "0.1.26",
        ),
        "idna": crate.spec(
            version = "1.1.0",
        ),
        "lazy_static": crate.spec(
            version = "1.5.1",
        ),
        "serde": crate.spec(
            version = "1.0.229",
        ),
        "serde_derive": crate.spec(
            version = "1.0.229",
        ),
        "serde_json": crate.spec(
            version = "1.0.154",
        ),
        "serde_yaml_ng": crate.spec(
            version = "0.10.0",
        ),
        "phf": crate.spec(
            version = "0.14",
            features = ["macros", "unicase"],
        ),
        "emojis": crate.spec(
            version = "0.9.1",
        ),
        "memchr": crate.spec(
            version = "2.8",
        ),
        "nom": crate.spec(
            version = "8",
        ),
        "unicode_categories": crate.spec(
            version = "0.1",
        ),
        "magnus": crate.spec(
            version = "0.9.2",
        ),
        "pyo3": crate.spec(
            version = "0.30",
            features = ["extension-module", "abi3-py312"],
        ),
        "pyo3-macros": crate.spec(
            version = "0.30",
        ),
        "libc": crate.spec(
            version = "0.2.190",
        ),
        "wasm-bindgen": crate.spec(
            version = "=0.2.121",
        ),
        "js-sys": crate.spec(
            version = "=0.3.98",
        ),
        "gungraun": crate.spec(
            version = "0.20.0",
        ),
    },
    repository_name = "twitter_text",
    tags = ["manual"],
)
