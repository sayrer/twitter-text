###############################################################################

# rules_swift >= 4.0.0 ships a standalone toolchain extension (upstream PR
# #1630), which replaces the hand-rolled http_archive + swift_toolchain wrapper
# that used to live in //tools/swift, along with the local patch that added a
# `toolchain_files` attribute to support it.
#
# macOS keeps using the Xcode toolchain that rules_swift configures natively;
# only the Linux platforms are pinned here.
SWIFT_VERSION = "6.4.0"

swift = use_extension("@rules_swift//swift:extensions.bzl", "swift")

# platform_sha256 restricts the generated toolchains to the Linux platforms
# used here (without it rules_swift declares one per platform it knows). The
# checksums come from rules_swift's swift_release_metadata.json.
swift.toolchain(
    name = "swift_toolchain",
    platform_sha256 = {
        "ubuntu22.04": "bce85ea80f1471b85f39993f9285dbc798ec8e1eac5f677e24b2ac693856f9f8",
        "ubuntu22.04-aarch64": "28c28acb2b91ed0e3beff5e6ba3695a785e645d9bd374adcaa3b7c2a901bc763",
    },
    swift_version = SWIFT_VERSION,
)
use_repo(
    swift,
    "swift_toolchain",
    "swift_toolchain_ubuntu22.04",
    "swift_toolchain_ubuntu22.04-aarch64",
)

register_toolchains("@swift_toolchain//:swift_toolchain_exec_ubuntu22.04")

